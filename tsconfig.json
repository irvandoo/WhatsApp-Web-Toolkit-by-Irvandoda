{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["chrome", "vite/client", "node"],
    "baseUrl": ".",
    "paths": { "@/*": ["app/*"] }
  },
  "include": ["app", "manifest.config.ts", "vite.config.ts"]
}
