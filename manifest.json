{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "__MSG_extDesc__",
  "version": "0.1.0",
  "default_locale": "id",
  "author": {
    "email": "irvando.d.a@gmail.com"
  },
  "homepage_url": "https://irvandoda.web.id",
  "icons": {
    "16": "public/icons/icon16.png",
    "48": "public/icons/icon48.png",
    "128": "public/icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/index.html"
  },
  "options_page": "options/index.html",
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "unlimitedStorage",
    "notifications"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*"
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "resources": [
        "dashboard/index.html",
        "crm/index.html",
        "templates/index.html",
        "analytics/index.html",
        "autoreply/index.html",
        "groups/index.html",
        "pos/index.html",
        "blast/index.html",
        "presets/index.html",
        "assets/*",
        "assets/credit-D45yROeQ.js",
        "assets/composer-insert-CIXApDVA.js",
        "assets/session-codec-BbjBUFD2.js",
        "assets/slots-DJejQdeJ.js",
        "assets/rotation-Boy0OiaH.js",
        "assets/crm-logic-BrfyloTL.js",
        "assets/autoreply-logic-D4459LnL.js",
        "assets/autoreply-types-Df-z_QjU.js",
        "assets/analytics-logic-CQSGZEo7.js",
        "assets/lead-intel-logic-Eys90P2A.js",
        "assets/outbox-logic-DQTJojXg.js",
        "assets/wa-format-Cxt_uRRu.js",
        "assets/template-engine-B5HOWEY9.js",
        "assets/crm-types-BrsAoK90.js",
        "assets/index.ts-CkN5vPxS.js",
        "assets/virtual-session.js-CWgDXvAI.js",
        "assets/wa-adapter.ts-anPQdLLZ.js"
      ],
      "use_dynamic_url": false
    }
  ],
  "content_scripts": [
    {
      "js": [
        "assets/index.ts-loader-BujpS3Qf.js"
      ],
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "run_at": "document_idle"
    },
    {
      "js": [
        "assets/virtual-session.js-CWgDXvAI.js"
      ],
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "js": [
        "assets/wa-adapter.ts-loader-BmAMMg0d.js"
      ],
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
